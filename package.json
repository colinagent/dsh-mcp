{
  "name": "@colinagent/dsh-mcp",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "description": "Directory-scoped MCP servers for DeepSeek Harness: read ~/.agents/mcp.json and <cwd>/.agents/mcp.json, mount per Agent so a workspace only gets the servers it declares.",
  "engines": {
    "node": ">=22.6",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "main": "dist/plugin.mjs",
  "exports": {
    ".": "./dist/plugin.mjs"
  },
  "files": [
    "dist/plugin.mjs",
    "cordis.patch.yml",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts --target=node --format=esm --external @deepseek-ai/* --outfile=dist/plugin.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-working-directory": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinagent/dsh-mcp.git"
  },
  "homepage": "https://github.com/colinagent/dsh-mcp#readme",
  "bugs": {
    "url": "https://github.com/colinagent/dsh-mcp/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mcp",
    "model-context-protocol",
    "plugin",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  }
}
